<!-- Number regexes and punctuation -->

<pardef n="num-prefix" c="see sme-nob-numeros">
  <e><re>[§\-‒–—―\+\*$€.]</re></e>
  <e><re>[§\-‒–—―\+] </re></e>
  <e><re>§§</re></e>
  <e><re>§§ </re></e>
  <e><re>s.</re></e>
</pardef>
<pardef n="num-arabicloop" c="see sme-nob-numeros">
  <e>
    <!-- note: that's not two spaces in the first [], but a space and an nbsp -->
    <re>([0-9]+([:'\-–—/  .,]|[.][\-–—]|[\-–—/] | \-\- | [\-–—/]| [\-–—.,\+] ))*</re> <!-- ARABIC then ARABICLOOP -->
    <re>[0-9]+</re> <!-- at least one ARABIC, then finals -->
  </e>
</pardef>
<pardef n="num-arabic" c="see sme-nob-numeros">
  <e><par n="num-arabicloop"/></e>
  <e><par n="num-prefix"/><par n="num-arabicloop"/></e>
  <e><par n="num-arabicloop"/><re>[abcdef]|f f</re></e>
  <e><par n="num-prefix"/><par n="num-arabicloop"/><re>[abcdef]|f f</re></e>
</pardef>
<pardef n="num-repeating" c="see sme-nob-numeros">
  <e r="RL"><re>([§\+-–] ?)?[0-9]+([.,][0-9]+)*([ \-]+[0-9]+([.,][0-9]+)*)*( *%)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
</pardef>
<pardef n="sme-nob-numeros" c="Used in sme-nob, should be RL to avoid messing up other pairs.
                               Also, the \+ in regexes here can’t be trimmed (and would mess up pretransfer in analysis anyway), so keep it RL.
                               (Also, this one pardef takes as long as the rest of the dix to compile, so without the RL the analyser also gets slow to compile …)">
  <!-- ordinals: -->
  <e r="RL"><re>[IVXLCDM\-]+</re><i>.</i><par n="første__adj"/></e>
  <e r="RL"><re>([§\+–] ?)?[0-9]+([.,][0-9]+)*([ \-]+[0-9]+([.,][0-9]+)*)*</re><i>.</i><par n="første__adj"/></e>
  <e r="RL"><par n="num-arabic"/><re>[.]?</re><i>.</i><par n="første__adj"/></e>
  <!-- determiners: -->
  <e r="RL"><par n="num-arabic"/><re>(,\-| \-| \-\-|%| %)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e r="RL"><par n="num-arabic"/><re>(,\-| \-| \-\-|%| %)?</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><par n="num-repeating"/><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <!-- 1300-tallet, etc har <dash>-taggen og får - etter seg: -->
  <e r="RL"><re>1</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><re>[02-9]</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><re>[0-9][0-9]+([.,][0-9]+)?</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><re>[0-9][.,][0-9]+</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>

  <e r="RL"><re>[½¹²³¼¾]</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><re>[IVXLCDM\-]+</re><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="RL"><par n="num-repeating"/><p><l>-</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="cmp"/><s n="guio"/></r></p></e>
</pardef>

<pardef n="numeros">
  <!-- separate out the number 1 as singular (fortunately "1.00" is usually plural!) -->
  <e>       <re>1( ?%)?</re><p><l></l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>
  <e>       <re>[02-9]+( ?%)?</re><p><l></l>             <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9][0-9]+( ?%)?</re><p><l></l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9]+([., ][0-9]+)+( ?%)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[0-9]+([., ][0-9]+)* (tusen|[mb]illi(on|ard)er)</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[½¹²³¼¾]</re><p><l></l>                  <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <!-- Numbers from 1000 to 2200 (or 20-99) might be years. Other numbers don't get to be years.
       Noun tagging would be better, but that doesn’t work with compounding
       since inconditional numerals override the unknown-analysis. -->
  <e c="date"><re>1[0-9][0-9][0-9]|2[0-2][0-9][0-9]|[2-9][0-9]</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="date"/></r></p></e>
  <e c="section"> <re>[0-9]+[\-][0-9]+</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>

  <e>       <re>1</re><p><l></l>                        <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p>  <par n="."/></e>
  <e>       <re>[02-9]</re><p><l></l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
  <e>       <re>[0-9][0-9]+([., ][0-9]+)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
  <e>       <re>[0-9][., ][0-9]+</re><p><l></l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
</pardef>

