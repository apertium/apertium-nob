</pardef>

<pardef n="cometa">
  <e c="left quote">             <p><l>‘</l>     <r>‘<s n="apos"/></r></p></e>
  <e c="right quote / genitive"> <p><l>’</l>     <r>’<s n="apos"/></r></p></e>
