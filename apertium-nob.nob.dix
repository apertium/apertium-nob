  <e>      <i>åttiende</i></e>
  <e>      <i>nittiende</i></e>
</pardef>

<pardef n="første-tjuende" c="No empty transition!">
  <e> <par n="første-niende"/> </e>
  <e> <par n="tiende-nittende"/> </e>
  <e r="LR"><p><l>tyvende</l><r>tjuende</r></p></e>
  <e>      <i>tjuende</i></e>
</pardef>

<pardef n="første-hundrede" c="No empty transition!">
  <e> <par n="første-niende"/> </e>
  <e> <par n="tiende-nittende"/> </e>
  <e>  <par n="tjuende-nittiende"/></e>
  <e>  <par n="tjue-nitti"/><par n="første-niende"/></e>
  <e><i>nullte</i></e>
  <e><i>hundrede</i></e>
  <e><i>tusende</i></e>
  <e><i>millionte</i></e>
  <e><i>milliardte</i></e>
</pardef>

