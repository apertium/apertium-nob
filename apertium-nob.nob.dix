  <e>      <i>syttende</i></e>
  <e>      <i>attende</i></e>
  <e>      <i>nittende</i></e>
</pardef>

<pardef n="tjuende-nittiende">
  <e r="LR"><p><l>tyvende</l><r>tjuende</r></p></e>
