  <e r="LR"><p><l>en</l>        <r><s n="n"/><s n="m"/><s n="sg"/><s n="def"/></r></p><par n="s_case\-_cp-both"/></e>
  <e r="LR"><p><l>er</l>        <r><s n="n"/><s n="m"/><s n="pl"/><s n="ind"/></r></p><par n="s_case\-_cp-both"/></e>
  <e r="LR"><p><l>ene</l>       <r><s n="n"/><s n="m"/><s n="pl"/><s n="def"/></r></p><par n="s_case\-_cp-both"/></e>
</pardef>

