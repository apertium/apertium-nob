  <e>	<i>M.</i></e>
  <e>	<i>N.</i></e>
  <e>	<i>O.</i></e>
  <e>	<i>P.</i></e>
  <e>	<i>Q.</i></e>
  <e>	<i>R.</i></e>
  <e>	<i>S.</i></e>
  <e>	<i>T.</i></e>
  <e>	<i>U.</i></e>
  <e>	<i>V.</i></e>
  <e>	<i>W.</i></e>
  <e>	<i>X.</i></e>
  <e>	<i>Y.</i></e>
  <e>	<i>Z.</i></e>
  <e>	<i>Æ.</i></e>
  <e>	<i>Ø.</i></e>
  <e>	<i>Å.</i></e>
</pardef>



